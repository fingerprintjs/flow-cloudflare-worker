# Fingerprint settings for the test worker, uploaded as worker secrets.
# Copy to the repo root as .env.verify.<staging|production>.local (gitignored by `.env.*.local`).

FP_PUBLIC_KEY=
FP_SECRET_KEY=
# Must match the workspace of the keys above (us, eu or ap).
FP_REGION=us
# Production defaults. Replace for staging.
FP_CDN_HOST=fpcdn.io
FP_INGRESS_BASE_HOST=api.fpjs.io
